#!/usr/bin/env bash

# fzf-cliphist: A simple fzf interface for cliphist

set -e
set -u

# Default values
PREVIEW_WINDOW="right:50%:wrap"
HEADER="Enter: Copy | Ctrl-Y: Copy (no exit) | Ctrl-P: Toggle preview"
COLOR="fg:#c0caf5,bg:#1a1b26,hl:#e0af68,fg+:#c0caf5,bg+:#292e42,hl+:#e0af68,info:#7aa2f7"
PASTE_TARGET="yes"

# Help message
show_help() {
    cat << EOF
Usage: fzf-cliphist [OPTIONS]

A simple fzf interface for cliphist.

Options:
  -h, --help           Show this help message and exit
  --images              Include images in the clipboard history
  --preview-window      fzf preview window option
  --header             fzf header option
  --color              fzf color option
  --paste-target       Paste to caller pane (yes/no)
EOF
}

# Check for dependencies
check_dependencies() {
    local missing=()
    for cmd in cliphist fzf wl-copy; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Error: Missing dependencies: ${missing[*]}" >&2
        exit 1
    fi
}

# Format item: colorize ID in Tokyo Night yellow/orange
format_item() {
    local item="$1"
    # Extract ID (first field)
    local id="${item%%	*}"
    # Extract content (rest after first tab)
    local content="${item#*	}"
    # Tokyo Night: yellow #e0af68 (ANSI 220)
    printf '%b%s%b\t%s\n' '\e[38;5;220m' "$id" '\e[0m' "$content"
}

# Main function
main() {
    local show_images=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --images)
                show_images=true
                shift
                ;;
            --preview-window)
                PREVIEW_WINDOW="$2"
                shift 2
                ;;
            --header)
                HEADER="$2"
                shift 2
                ;;
            --color)
                COLOR="$2"
                shift 2
                ;;
            --paste-target)
                PASTE_TARGET="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    check_dependencies

    local list
    if [[ "$show_images" == true ]]; then
        list=$(cliphist list 2>/dev/null || true)
    else
        # Filter out images (binary data) by default
        list=$(cliphist list 2>/dev/null | grep -v '\[\[ binary data' || true)
    fi

    if [[ -z "$list" ]]; then
        echo "Clipboard history is empty."
        exit 0
    fi

    # Colorize IDs in the list
    list=$(echo "$list" | while IFS= read -r line; do format_item "$line"; done)

    # Get script path for preview
    local script_path="${BASH_SOURCE[0]}"

    local selection
    selection=$(echo "$list" | fzf \
        --ansi \
        --color="$COLOR" \
        --preview="$script_path --preview {}" \
        --preview-window="$PREVIEW_WINDOW" \
        --header="$HEADER" \
        --bind='ctrl-p:toggle-preview' \
        --bind='ctrl-y:execute-silent(cliphist decode {1} | wl-copy)+abort')

    if [[ -n "$selection" ]]; then
        # Extract ID (first field) - strip ANSI codes first
        local clean_selection
        clean_selection=$(echo "$selection" | sed 's/\x1b\[[0-9;]*m//g')
        local id="${clean_selection%%	*}"

        # Get decoded content
        local decoded
        decoded=$(cliphist decode "$id")

        # Paste to caller pane if enabled
        if [[ "$PASTE_TARGET" == "yes" ]]; then
            # TMUX_PANE is set inside tmux popup
            if [[ -n "${TMUX_PANE:-}" ]]; then
                # Paste into the caller pane (previous pane in the stack)
                tmux paste-buffer -t "{last}" -b "${TMUX_PANE}"
                # Alternative: send to last pane
                # tmux send-keys -t "{last}" "$decoded"
            else
                # Fallback to wl-copy if not in tmux
                echo "$decoded" | wl-copy
            fi
        else
            # Default: use wl-copy
            echo "$decoded" | wl-copy
        fi
    fi
}

# Preview handler: extract ID and decode
preview_handler() {
    local item="$1"
    # Strip ANSI codes and extract ID
    local clean_item
    clean_item=$(echo "$item" | sed 's/\x1b\[[0-9;]*m//g')
    local id="${clean_item%%	*}"
    cliphist decode "$id"
}

# Parse arguments for preview mode
if [[ "${1:-}" == "--preview" ]]; then
    preview_handler "$2"
    exit 0
fi

main "$@"
