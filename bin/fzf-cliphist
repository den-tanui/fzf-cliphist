#!/usr/bin/env bash

# fzf-cliphist: A simple fzf interface for cliphist

set -e
set -u

# Help message
show_help() {
    cat << EOF
Usage: fzf-cliphist [OPTIONS]

A simple fzf interface for cliphist.

Options:
  -h, --help    Show this help message and exit
  --images       Include images in the clipboard history
EOF
}

# Check for dependencies
check_dependencies() {
    local missing=()
    for cmd in cliphist fzf wl-copy; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Error: Missing dependencies: ${missing[*]}" >&2
        exit 1
    fi
}

# Main function
main() {
    local show_images=false

    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help
                exit 0
                ;;
            --images)
                show_images=true
                ;;
        esac
    done

    check_dependencies

    local list
    if [[ "$show_images" == true ]]; then
        list=$(cliphist list 2>/dev/null || true)
    else
        # Filter out images (binary data) by default
        # cliphist outputs: INDEX[[ binary data SIZE FORMAT WxH ]]
        list=$(cliphist list 2>/dev/null | grep -v '\[\[ binary data' || true)
    fi

    if [[ -z "$list" ]]; then
        echo "Clipboard history is empty."
        exit 0
    fi

    local selection
    # Use fzf with no preview by default
    # Multi-line items: fzf handles tabs in cliphist output naturally
    selection=$(echo "$list" | fzf \
        --header='Enter: Copy | Ctrl-Y: Copy (no exit)' \
        --bind 'ctrl-y:execute-silent(cliphist decode <<< {} | wl-copy)+abort')

    if [[ -n "$selection" ]]; then
        cliphist decode <<< "$selection" | wl-copy
    fi
}

main "$@"
